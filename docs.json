          "user-guide/wallets-and-transactions"
        ]
      },
      {
        "group": "Language clients",
        "pages": [
          "sdks/overview",
          "sdks/typescript",
          "sdks/python",
          "sdks/go",
          "sdks/php"
        ]
      },
      {
        "group": "Integration guides",
        "pages": [
          "guides/create-first-wallet",
          "guides/credit-a-wallet",
          "guides/migrate-to-live"
        ]
      },
      {
        "group": "API reference",
        "pages": [
          "reference/api-conventions",
          "developer-guide/wallet-api",
          "developer-guide/provider-routing",
